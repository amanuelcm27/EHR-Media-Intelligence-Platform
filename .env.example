# ---------------------------------------------------------------------------
# EHR Media Intelligence Platform - configuration
# Copy to .env and adjust. Every value can also be set as an env var.
# ---------------------------------------------------------------------------

# Storage
EHR_DATA_DIR=data/raw
EHR_ARTIFACTS_DIR=artifacts

# --- Embeddings ------------------------------------------------------------
# auto | sentence-transformers | hashing | openai
EHR_EMBEDDING_PROVIDER=auto
EHR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EHR_EMBEDDING_DIM=384

# --- Vector index ----------------------------------------------------------
# auto | faiss | numpy
EHR_VECTOR_BACKEND=auto

# --- Summarization LLM -----------------------------------------------------
# auto | anthropic | openai | offline
# "auto" uses Anthropic/OpenAI when a key is present, otherwise the
# deterministic offline summarizer (no PHI leaves the machine).
EHR_LLM_PROVIDER=auto
EHR_ANTHROPIC_MODEL=claude-sonnet-4-5
EHR_OPENAI_MODEL=gpt-4o-mini
EHR_ANTHROPIC_API_KEY=
EHR_OPENAI_API_KEY=
EHR_MAX_SUMMARY_WORDS=200

# Search
EHR_DEFAULT_TOP_K=5
EHR_HYBRID_WEIGHT=0.15
